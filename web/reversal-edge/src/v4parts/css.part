<meta charset="utf-8">
<title>QuantLab Mean-Reversion Terminal</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
<style>
:root{color-scheme:dark;--page:#0d0d0d;--panel:#141413;--surface:#1a1a19;--s2:#20201f;--ink:#fff;--ink2:#c3c2b7;--muted:#898781;--grid:#2c2c2a;--axis:#383835;--hair:rgba(255,255,255,.08);--blue:#3987e5;--red:#e66767;--violet:#9085e9;--good:#0ca30c;--warn:#fab219;--crit:#d03b3b;
--sans:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;--mono:"JetBrains Mono",ui-monospace,Menlo,monospace}
*{box-sizing:border-box}
html,body{background:var(--page);color:var(--ink2);font:13px/1.45 var(--sans);margin:0}
.hdr{display:flex;flex-wrap:wrap;align-items:flex-end;gap:10px 16px;padding:10px 16px;background:var(--panel);border-bottom:1px solid var(--hair);position:sticky;top:env(safe-area-inset-top,0px);z-index:20}
.brand b{display:block;color:var(--ink);letter-spacing:.14em;font-size:13px}.brand span{color:var(--muted);font-size:10px;letter-spacing:.06em;text-transform:uppercase}
.f{display:flex;flex-direction:column;gap:3px}.f label{color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.05em}
select,.rng button{background:var(--s2);color:var(--ink);border:1px solid var(--hair);border-radius:5px;padding:5px 8px;font:12px var(--sans)}
.rng{display:flex;gap:4px}.rng button{cursor:pointer;color:var(--ink2)}.rng button.on{background:#1c4f8f;border-color:#2a78d6;color:#fff}
.badge{align-self:center;font-size:10px;letter-spacing:.08em;padding:4px 8px;border-radius:4px;color:var(--warn);border:1px solid rgba(250,178,25,.5)}
.snap{align-self:center;color:var(--muted);font-size:11px;margin-left:auto}
.tabs{display:flex;gap:4px;padding:0 16px;border-bottom:1px solid var(--hair);overflow-x:auto}
.tabs button{background:none;border:0;border-bottom:2px solid transparent;color:var(--muted);padding:9px 14px;font:13px var(--sans);cursor:pointer;white-space:nowrap}
.tabs button.on{color:var(--ink);border-bottom-color:var(--blue)}
button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--blue);outline-offset:1px}
main{padding:10px 16px 40px}
.chartwrap{display:flex;gap:12px;align-items:flex-start}.cc{flex:1;min-width:0}
.ctl{display:flex;flex-wrap:wrap;gap:6px 14px;align-items:center;margin-bottom:6px;font-size:12px}.ctl label{display:inline-flex;gap:4px;align-items:center;cursor:pointer}
.ctl input{accent-color:var(--blue)}
#plot{border:1px solid var(--hair);border-radius:6px;overflow:hidden;background:var(--surface)}
.scrub{display:flex;align-items:center;gap:10px;padding:8px 2px}.scrub input{flex:1;accent-color:var(--blue)}.scrub span{font:11px var(--mono);color:var(--muted);min-width:90px}
.insp{width:360px;flex-shrink:0;background:var(--surface);border:1px solid var(--hair);border-radius:6px;padding:10px;position:sticky;top:112px;max-height:calc(100vh - 124px);overflow-y:auto}
.ih{display:flex;gap:10px;align-items:baseline;border-bottom:1px solid var(--hair);padding-bottom:6px;margin-bottom:8px}.ih b{color:var(--ink);font-size:14px}.ih span{font-family:var(--mono)}.pin{margin-left:auto;font-size:9px;letter-spacing:.08em;border:1px solid var(--axis);padding:1px 5px;border-radius:3px;color:var(--muted)}.pin.on{color:var(--warn);border-color:rgba(250,178,25,.5)}
.top2{display:grid;grid-template-columns:1fr 1fr;gap:8px}.lab{color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.06em}
.bigp{color:var(--ink);font-size:26px;font-weight:500;line-height:1.1}.note{color:var(--muted);font:10px var(--mono)}
.act{font-size:14px;font-weight:600;margin-top:4px}.act.on{color:var(--good)}
.gates{display:grid;grid-template-columns:1fr 1fr;gap:2px 8px;margin:8px 0;font-size:11px}.ok{color:var(--good);font-weight:700;margin-right:4px}.no{color:var(--crit);font-weight:700;margin-right:4px}
.sec{color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.06em;margin:12px 0 4px}
table.t{width:100%;border-collapse:collapse;font-size:11px}table.t td{padding:2px 4px;border-bottom:1px solid var(--grid)}td.n{text-align:right;font-family:var(--mono);font-variant-numeric:tabular-nums}
.pill{display:inline-block;min-width:56px;text-align:center;border-radius:3px;padding:1px 4px;font:10px var(--mono)}
.fb{display:grid;grid-template-columns:84px 1fr 34px;gap:6px;align-items:center;margin:2px 0;font-size:10px}.tr{height:6px;background:var(--s2);border-radius:3px;overflow:hidden}.tr i{display:block;height:100%}
.sh{display:grid;grid-template-columns:120px 1fr;gap:6px;align-items:center;margin:2px 0;font:10px var(--mono)}.sh .bar{height:10px;position:relative;background:var(--s2)}.sh .bar i{position:absolute;top:0;bottom:0}
.hind{border-top:1px dashed var(--axis);margin-top:8px;padding-top:6px;font:10px var(--mono);color:var(--muted)}
.kpis{display:grid;grid-template-columns:repeat(auto-fill,minmax(128px,1fr));gap:6px;margin-bottom:10px}
.k{background:var(--panel);border:1px solid var(--hair);border-radius:5px;padding:6px 8px}.k .v{color:var(--ink);font-size:16px;font-weight:500;margin-top:2px}.k .v.pos{color:#6fd06f}.k .v.neg{color:#f08c8c}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,540px),1fr));gap:10px}
.card{background:var(--surface);border:1px solid var(--hair);border-radius:6px;padding:10px}.card h3{margin:0 0 6px;color:var(--ink);font-size:14px}.card h3 span{color:var(--muted);font-weight:400;font-size:11px;margin-left:8px}
.kg{display:grid;grid-template-columns:repeat(5,1fr);gap:4px}.kg .k .v{font-size:14px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:8px}
h2{color:var(--ink);font-size:13px;font-weight:500;margin:18px 0 8px}
.tw{overflow-x:auto;border:1px solid var(--hair);border-radius:6px}
table.bl{border-collapse:collapse;width:100%;font:11px var(--mono);font-variant-numeric:tabular-nums}
table.bl th{position:sticky;top:0;background:var(--panel);color:var(--muted);font-weight:500;text-transform:uppercase;font-size:10px;text-align:right;padding:6px 8px;cursor:pointer;white-space:nowrap}
table.bl td{padding:4px 8px;border-top:1px solid #232321;text-align:right;white-space:nowrap}table.bl tr:hover td{background:#242423;cursor:pointer}
table.bl th:nth-child(-n+3),table.bl td:nth-child(-n+3){text-align:left}
.about{max-width:70ch;font-size:14px;line-height:1.6}.about p{margin:10px 0}.about code{font:12px var(--mono);background:var(--s2);padding:1px 5px;border-radius:3px}
.loading{padding:60px 0;text-align:center;color:var(--muted)}
@media (max-width:1100px){.chartwrap{flex-direction:column}.insp{width:100%;position:static;max-height:none}.two{grid-template-columns:1fr}.kg{grid-template-columns:repeat(3,1fr)}.snap{margin-left:0}}
</style>
<style>
.drop{border:1.5px dashed var(--axis);border-radius:8px;padding:22px;text-align:center;color:var(--muted);background:var(--surface);cursor:pointer}
.drop.over{border-color:var(--blue);color:var(--ink)}.drop b{color:var(--ink)}
.grid2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px}
.panel{background:var(--surface);border:1px solid var(--hair);border-radius:8px;padding:12px 14px}
.panel h3{margin:0 0 8px;color:var(--ink);font-size:13px;font-weight:600}
.ds{display:grid;grid-template-columns:1fr auto auto;gap:8px;align-items:center;padding:6px 0;border-bottom:1px solid var(--grid);font-size:12px}
.ds:last-child{border-bottom:0}.ds b{color:var(--ink)}.ds .note{font-size:10px}
.x{background:none;border:1px solid var(--hair);color:var(--muted);border-radius:4px;cursor:pointer;padding:2px 8px}
.set{display:grid;grid-template-columns:1fr 110px;gap:4px 10px;align-items:center;font-size:12px}
.set label{color:var(--ink2)}.set input,.set select{width:100%;background:var(--page);color:var(--ink);border:1px solid var(--hair);border-radius:4px;padding:4px 6px;font:12px var(--mono)}
.set .h{grid-column:1/-1;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.06em;margin-top:8px}
.btn{background:#1c4f8f;border:1px solid #2a78d6;color:#fff;border-radius:5px;padding:7px 14px;font:13px var(--sans);cursor:pointer}
.btn.ghost{background:var(--s2);border-color:var(--hair);color:var(--ink2)}
.btn:disabled{opacity:.5;cursor:default}
.bar{height:4px;background:var(--s2);border-radius:2px;overflow:hidden;margin-top:8px}.bar i{display:block;height:100%;width:0;background:var(--violet);transition:width .2s}
.status{font:11px var(--mono);color:var(--muted);margin-top:6px;min-height:14px}
.err{color:#f08c8c}
.live{align-self:center;font-size:10px;letter-spacing:.08em;padding:4px 8px;border-radius:4px;color:var(--good);border:1px solid rgba(12,163,12,.5)}
.empty{padding:40px 0;color:var(--muted);text-align:center}
@media (max-width:900px){.grid2{grid-template-columns:1fr}}
</style>

