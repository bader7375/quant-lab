// ------------------------------------------------ model
function calFig(c,h=260){const T=[{x:[0,1],y:[0,1],mode:"lines",line:{color:C.axis,width:1},hoverinfo:"skip",showlegend:false}];
 if(c&&c.p_mean)T.push({x:c.p_mean,y:c.y_rate,mode:"lines+markers",line:{color:C.violet,width:2},marker:{size:7,color:C.violet},customdata:c.n,showlegend:false,error_y:{type:"data",symmetric:false,array:c.hi.map((v,k)=>v-c.y_rate[k]),arrayminus:c.lo.map((v,k)=>c.y_rate[k]-v),color:rgba(C.violet,.6),thickness:1,width:0},hovertemplate:"predicted %{x:.3f} · observed %{y:.3f} · n %{customdata}<extra></extra>"});
 return [T,base(h,{title:{text:"reliability (out of sample)",font:{size:11,color:C.ink2},x:.01},showlegend:false,xaxis:{range:[0,1],gridcolor:C.grid,title:{text:"predicted",font:{size:10}}},yaxis:{range:[0,1],gridcolor:C.grid,title:{text:"observed",font:{size:10}}}})]}
function famWeights(d){const fams=Object.keys(C.fam),a=1-Math.pow(.5,1/4);let sm=null;const rows=d.steps.map(s=>{const raw=fams.map(f=>RES.names.reduce((acc,n,k)=>{const sp=RES.features.find(x=>x[0]===n);return acc+(sp&&sp[1]===f?Math.abs(s.coef[k]):0)},0));
  const tot=raw.reduce((x,y)=>x+y,0)||1,sh=raw.map(v=>v/tot);sm=sm?sm.map((v,k)=>v+a*(sh[k]-v)):sh;return sm});return {fams,rows,d:d.steps.map(s=>s.d)}}
function drawModel(){if(!RES){needRun("cards");["impbars","famarea","calib","roc"].forEach(id=>$(id).innerHTML="");$("imp-title").textContent="";return}
 const m=RES.metrics.symbols,ok=RES.syms.filter(s=>RES.symbols[s]);
 $("cards").innerHTML=ok.map(s=>{const c=m[s].classification,t=m[s].trading,K=(l,v,cls="")=>`<div class="k"><div class="lab">${l}</div><div class="v ${cls}">${v}</div></div>`;
  return `<div class="card"><h3>${esc(s)}<span>${c.n} OOS samples · base rate ${fmt(c.base_rate,2)}</span></h3><div class="kg">${K("ROC AUC",fmt(c.roc_auc))}${K("Brier skill",fmt(c.brier_skill,3),c.brier_skill>0?"pos":"neg")}${K("ECE",fmt(c.ece))}${K("Prec@thr",fmt(c.precision_at_thr))}${K("Signals",m[s].signals)}
   ${K("Trades",t.n_trades)}${K("Win",pct(t.win_rate,0))}${K("Exp.",fmt(t.expectancy_R,2,"R"))}${K("P&L",Math.round(t.pnl).toLocaleString())}${K("Retrains",RES.symbols[s].steps.length)}</div><div id="cal-${esc(s)}" style="margin-top:6px"></div></div>`}).join("");
 ok.forEach(s=>Plotly.react("cal-"+s,...calFig(m[s].classification.cal),{displayModeBar:false,responsive:true}));
 const d=S();if(!d)return;const fw=famWeights(d);$("imp-title").textContent=`${st.sym} · feature weights: |standardised coefficient| by family, EWMA-smoothed across retrains`;
 const is=$("impstep");is.max=Math.max(0,d.steps.length-1);if(!is.dataset.touched||+is.value>+is.max)is.value=is.max;impBars();
 Plotly.react("famarea",fw.fams.map((f,k)=>({x:fw.d,y:fw.rows.map(r=>r[k]),name:f,mode:"lines",stackgroup:"one",line:{width:.5,color:C.fam[f]},fillcolor:rgba(C.fam[f],.75),hovertemplate:f+" %{y:.0%}<extra></extra>"})),
  base(620,{title:{text:"weight share by feature family over retrains",font:{size:11,color:C.ink2},x:.01},hovermode:"x unified",yaxis:{range:[0,1],tickformat:".0%",gridcolor:C.grid},legend:{orientation:"h",x:0,y:-.1,yanchor:"top",font:{size:9}},margin:{l:44,r:10,t:30,b:70}}),CFG);
 Plotly.react("calib",...calFig(m[st.sym].classification.cal,320),CFG);
 const pairs=[];d.p.forEach((p,i)=>{if(isF(p)&&d.dom[i]&&isF(d.y[i]))pairs.push([p,d.y[i]])});pairs.sort((a,b)=>b[0]-a[0]);const P=pairs.filter(q=>q[1]===1).length,Nn=pairs.length-P;let tp=0,fp=0;const fx=[0],fy=[0];pairs.forEach(q=>{q[1]?tp++:fp++;fx.push(fp/Nn);fy.push(tp/P)});
 Plotly.react("roc",[{x:[0,1],y:[0,1],mode:"lines",line:{color:C.axis,width:1},showlegend:false,hoverinfo:"skip"},{x:fx,y:fy,mode:"lines",line:{color:C.violet,width:2},showlegend:false,hovertemplate:"FPR %{x:.2f} TPR %{y:.2f}<extra></extra>"}],
  base(320,{title:{text:`ROC · AUC ${fmt(m[st.sym].classification.roc_auc)}`,font:{size:11,color:C.ink2},x:.01},showlegend:false,xaxis:{range:[0,1],gridcolor:C.grid},yaxis:{range:[0,1],gridcolor:C.grid}}),CFG)}
function impBars(){const d=S();if(!d||!d.steps.length)return;const i=+$("impstep").value,s=d.steps[i];$("impd").textContent=s.d;
 const items=RES.names.map((n,k)=>[n,s.coef[k]]).sort((a,b)=>Math.abs(b[1])-Math.abs(a[1])).reverse();
 Plotly.react("impbars",[{type:"bar",orientation:"h",x:items.map(q=>q[1]),y:items.map(q=>q[0]),marker:{color:items.map(q=>C.fam[(RES.features.find(f=>f[0]===q[0])||[])[1]]||C.muted)},
  customdata:items.map(q=>(RES.features.find(f=>f[0]===q[0])||["","",""]).slice(1)),hovertemplate:"%{y} · %{customdata[0]}<br>%{customdata[1]}<br>coefficient %{x:+.3f}<extra></extra>"}],
  base(620,{title:{text:`coefficients at retrain ${s.d} (${s.n} samples, ${s.own} own) · + raises P(revert)`,font:{size:11,color:C.ink2},x:.01},showlegend:false,margin:{l:130,r:12,t:30,b:28},yaxis:{tickfont:{family:"JetBrains Mono,monospace",size:10,color:C.ink2}}}),CFG)}
$("impstep").addEventListener("input",e=>{e.target.dataset.touched=1;impBars()});

// ------------------------------------------------ performance
function drawPerf(){if(!RES){needRun("pk");["eqplot","rhist","exits","monthly"].forEach(id=>$(id).innerHTML="");$("attr").innerHTML="";return}
 const p=RES.metrics.portfolio,c=RES.metrics.pooled,bt=RES.bt,K=(l,v,n="",cls="")=>`<div class="k"><div class="lab">${l}</div><div class="v ${cls}">${v}</div><div class="note">${n}</div></div>`;
 $("pk").innerHTML=K("Sharpe",fmt(p.sharpe,2),"buy&hold "+fmt(p.bh_sharpe,2),p.sharpe>0?"pos":"neg")+K("Sortino",fmt(p.sortino,2))+K("CAGR",pct(p.cagr,2))+K("Max DD",pct(p.max_drawdown),"buy&hold "+pct(p.bh_max_drawdown))
  +K("Trades",p.n_trades,fmt(p.trades_per_year,1)+"/yr")+K("Win rate",pct(p.win_rate))+K("Expectancy",fmt(p.expectancy_R,2,"R"),"",p.expectancy_R>0?"pos":"neg")+K("Profit factor",fmt(p.profit_factor,2))+K("OOS AUC",fmt(c.roc_auc),"Brier skill "+fmt(c.brier_skill,3));
 if(!bt.eq.length){$("eqplot").innerHTML='<div class="empty">No out-of-sample period to simulate.</div>';return}
 Plotly.react("eqplot",[{x:bt.d,y:bt.eq,name:"strategy",line:{color:C.blue,width:2},hovertemplate:"strategy %{y:,.0f}<extra></extra>"},{x:bt.d,y:bt.bh,name:"buy & hold (equal weight)",line:{color:C.muted,width:1.3},hovertemplate:"buy & hold %{y:,.0f}<extra></extra>"},
  {x:bt.d,y:bt.dd,name:"strategy drawdown",fill:"tozeroy",line:{color:C.red,width:1},fillcolor:rgba(C.red,.35),yaxis:"y2",hovertemplate:"DD %{y:.1f}%<extra></extra>"},{x:bt.d,y:bt.bhdd,name:"buy & hold drawdown",line:{color:C.muted,width:1},yaxis:"y2",hovertemplate:"B&H DD %{y:.1f}%<extra></extra>"}],
  base(520,{hovermode:"x unified",hoversubplots:"axis",yaxis:{domain:[.34,1],type:"log",gridcolor:C.grid},yaxis2:{domain:[0,.3],ticksuffix:"%",gridcolor:C.grid},legend:{x:.005,y:.99,yanchor:"top",orientation:"h",bgcolor:"rgba(26,26,25,.75)",font:{size:10}},
   annotations:[{text:"equity · strategy vs buy & hold",xref:"paper",yref:"paper",x:1,y:1,xanchor:"right",yanchor:"bottom",showarrow:false,font:{size:10,color:C.muted}},{text:"underwater (drawdown)",xref:"paper",yref:"paper",x:1,y:.3,xanchor:"right",yanchor:"bottom",showarrow:false,font:{size:10,color:C.muted}}]}),CFG);
 const R=bt.trades.map(t=>Math.max(-4,Math.min(4,t.R))).filter(isF);
 Plotly.react("rhist",[{type:"histogram",x:R.filter(r=>r>0),xbins:{start:-4,end:4,size:.25},name:"winners",marker:{color:rgba(C.good,.8),line:{color:C.surface,width:1}}},{type:"histogram",x:R.filter(r=>r<=0),xbins:{start:-4,end:4,size:.25},name:"losers",marker:{color:rgba(C.crit,.8),line:{color:C.surface,width:1}}}],
  base(270,{barmode:"overlay",title:{text:"R-multiple distribution",font:{size:11,color:C.ink2},x:.01},margin:{l:40,r:10,t:40,b:28},legend:{x:.99,xanchor:"right",y:.98,yanchor:"top",font:{size:10}}}),CFG);
 const ex={};bt.trades.forEach(t=>{(ex[t.exit_reason]=ex[t.exit_reason]||[]).push(isF(t.R)?t.R:0)});const er=Object.entries(ex).map(([k,v])=>[k,v.length,v.reduce((a,b)=>a+b,0)/v.length]).sort((a,b)=>a[1]-b[1]);
 Plotly.react("exits",[{type:"bar",orientation:"h",x:er.map(q=>q[1]),y:er.map(q=>q[0]),marker:{color:er.map(q=>q[2]>0?C.good:C.crit)},text:er.map(q=>(q[2]>=0?"+":"")+q[2].toFixed(2)+"R avg"),textposition:"outside",textfont:{size:10,color:C.ink2},hovertemplate:"%{y}: %{x} trades<extra></extra>"}],
  base(270,{title:{text:"exits by reason (colour = average R sign)",font:{size:11,color:C.ink2},x:.01},showlegend:false,margin:{l:70,r:70,t:40,b:28}}),CFG);
 const mo={};bt.d.forEach((d,i)=>{if(!i)return;const k=d.slice(0,7);mo[k]=(mo[k]||1)*(bt.eq[i]/bt.eq[i-1])});const years=[...new Set(Object.keys(mo).map(k=>k.slice(0,4)))];
 const Z=years.map(y=>Array.from({length:12},(_,m)=>{const v=mo[`${y}-${String(m+1).padStart(2,"0")}`];return v?(v-1)*100:null}));
 Plotly.react("monthly",[{type:"heatmap",z:Z,x:["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"],y:years,zmid:0,zmin:-4,zmax:4,colorscale:[[0,C.red],[.5,"#383835"],[1,C.blue]],xgap:2,ygap:2,
  text:Z.map(r=>r.map(v=>v==null?"":v.toFixed(1))),texttemplate:"%{text}",textfont:{size:9,color:C.ink},colorbar:{thickness:10,ticksuffix:"%"},hovertemplate:"%{y} %{x}: %{z:.2f}%<extra></extra>"}],
  base(Math.max(260,22*years.length+70),{title:{text:"monthly returns (%)",font:{size:11,color:C.ink2},x:.01},yaxis:{autorange:"reversed"},showlegend:false}),CFG);
 $("attr").innerHTML="<tr>"+["symbol","signals","trades","P&L","win","exp. R","AUC","Brier skill","ECE"].map(h=>`<th>${h}</th>`).join("")+"</tr>"+RES.syms.filter(s=>RES.symbols[s]).map(s=>{const t=RES.metrics.symbols[s].trading,c=RES.metrics.symbols[s].classification;
  return "<tr>"+[esc(s),RES.metrics.symbols[s].signals,t.n_trades,Math.round(t.pnl).toLocaleString(),pct(t.win_rate),fmt(t.expectancy_R,2),fmt(c.roc_auc),fmt(c.brier_skill,3),fmt(c.ece)].map(v=>`<td>${v}</td>`).join("")+"</tr>"}).join("")}

// ------------------------------------------------ trades
const TC=[["trade_id","#"],["symbol","symbol"],["direction","side"],["entry_date","entry"],["exit_date","exit"],["bars_held","bars"],["exit_reason","exit reason"],["entry_price","entry px"],["exit_price","exit px"],["R","R"],["pnl","P&L"],["weight","size"],["p","P"],["p_lo","P low"],["z_entry","z"],["regime","regime"]];
let tsort={k:"trade_id",asc:true};
const tval=(k,v)=>k==="pnl"?Math.round(v).toLocaleString():k==="R"?(isF(v)?(v>=0?"+":"")+v.toFixed(2):"—"):k==="regime"?({1:"mean-rev",0:"neutral","-1":"trending"}[v]):typeof v==="number"&&!Number.isInteger(v)?v.toFixed(2):esc(v);
function drawTrades(){if(!RES){$("trt").innerHTML='<tr><td class="empty">Run the walk-forward in the Data tab first.</td></tr>';return}
 let t=RES.bt.trades.slice();if($("trsym").checked)t=t.filter(x=>x.symbol===st.sym);t.sort((a,b)=>{const u=a[tsort.k],v=b[tsort.k];return (u>v?1:u<v?-1:0)*(tsort.asc?1:-1)});
 $("trt").innerHTML="<tr>"+TC.map(([k,h])=>`<th data-k="${k}">${h}${tsort.k===k?(tsort.asc?" ▲":" ▼"):""}</th>`).join("")+"</tr>"+(t.length?t.map(x=>`<tr data-s="${esc(x.symbol)}" data-d="${x.entry_date}">`+TC.map(([k])=>`<td style="${k==="R"?`color:${x.R>0?"#6fd06f":"#f08c8c"}`:""}">${tval(k,x[k])}</td>`).join("")+"</tr>").join(""):`<tr><td colspan="16" class="note" style="text-align:left">No trades with these settings. Try a lower probability threshold, entry |z| or min confluence.</td></tr>`)}
$("trt").addEventListener("click",e=>{const th=e.target.closest("th");if(th){const k=th.dataset.k;tsort={k,asc:tsort.k===k?!tsort.asc:true};drawTrades();return}
 const tr=e.target.closest("tr[data-s]");if(!tr)return;st.sym=tr.dataset.s;sel.value=st.sym;const d=S(),i=d.d.indexOf(tr.dataset.d);st.n=Math.max(252,d.d.length-i+60);document.querySelectorAll("#rng button").forEach(b=>b.classList.remove("on"));st.cursor=i;st.pinned=true;show("chart")});
$("trsym").addEventListener("change",drawTrades);
window.claude?.use?.("downloads").then(dl=>{if(!dl)return;const b=$("dlcsv");b.hidden=false;b.addEventListener("click",async()=>{if(!RES)return;
 const rows=[TC.map(c=>c[0]).join(",")].concat(RES.bt.trades.map(t=>TC.map(([k])=>t[k]).join(",")));try{await dl.save({filename:"quantlab_trades.csv",data:rows.join("\n")})}catch(e){}})}).catch(()=>{});

